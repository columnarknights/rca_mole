HOST=0.0.0.0
PORT=3080
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080

ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false

# Generate with: openssl rand -hex 32 (and -hex 16 for CREDS_IV)
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=

# Read by librechat.yaml's ${GEMINI_API_KEY} substitution (custom/OpenAI-compat
# endpoint; kept for simple chat, but MCP tool calls need the native Google
# endpoint below — see GOOGLE_KEY)
GEMINI_API_KEY=

# Native Gemini endpoint (required for MCP tools to work correctly)
GOOGLE_KEY=
GOOGLE_MODELS=gemini-flash-lite-latest,gemini-flash-latest

# Read by docker-compose.yml for the clickhouse-mcp service (same values as ../.env)
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=
CLICKHOUSE_SECURE=true
