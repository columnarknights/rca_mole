# Copy to .env and fill in. Never commit the real .env file.

# --- ClickHouse (Cloud or local dev) ---
CLICKHOUSE_HOST=localhost
# HTTP(S) interface port, used by the Python client (clickhouse-connect)
CLICKHOUSE_PORT=8443
# Native protocol port, used only by the clickhouse-client bulk-load script
CLICKHOUSE_NATIVE_PORT=9440
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=inmobi
# true for ClickHouse Cloud / HTTPS, false for local plaintext dev server
CLICKHOUSE_SECURE=true

# --- Gemini (narration only; all analysis happens in ClickHouse) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- Langfuse (tracing the investigation pipeline) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- LibreChat "Follow up" handoff (see librechat/create_followup_agent.py) ---
LIBRECHAT_BASE_URL=http://localhost:3080
LIBRECHAT_FOLLOWUP_AGENT_ID=

# --- Live monitor (see rca/live_monitor.py) ---
# How often it polls fact_events' row count.
LIVE_POLL_SECONDS=2
# Continuous seconds of an unchanged row count before it's treated as
# "ingestion has gone quiet" and an incremental scan+investigate fires.
LIVE_IDLE_SECONDS=10
